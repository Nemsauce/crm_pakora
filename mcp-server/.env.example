# Project URL (HTTPS), never the Next.js URL
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Publishable sb_publishable_... key, or legacy anon JWT. NOT a service-role key.
SUPABASE_ANON_KEY=
# Short-lived signed JWT whose top-level role is exactly crm_mcp_reader.
# This role MUST have SELECT-only grants and read-only RPC permissions; see README.
SUPABASE_READ_ONLY_TOKEN=
