# Must match WHATSAPP_BRIDGE_SECRET configured in the CRM deployment.
WHATSAPP_BRIDGE_SECRET=

# Required local identifier for this independent WhatsApp account.
# Use a different value for each instance, for example CO and MX.
# It controls the local auth_session/<label>/ folder and log prefix only.
WHATSAPP_ACCOUNT_LABEL=CO

# Production default. Override with a local Next.js URL when testing locally.
CRM_WEBHOOK_URL=https://crm.pakora.online/api/webhooks/whatsapp-incoming
