# Supabase project URL for browser/client usage (added in a future commit).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon/public key for browser/client usage (added in a future commit).
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Supabase service role key for server-side admin tasks; server-only, never expose to client (added in a future commit).
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

# Self-hosted n8n instance base URL, used by scripts/n8n/ maintenance scripts only, not by the Next.js app itself.
N8N_BASE_URL="https://n8n.example.com"

# n8n REST API key, Settings -> n8n API. Used by scripts/n8n/ maintenance scripts only.
N8N_API_KEY="replace-with-n8n-api-key"

# Shared secret for n8n -> backend webhook auth, server-only.
WEBHOOK_SHARED_SECRET="replace-with-webhook-shared-secret"

# Vercel Cron auth, injected automatically as Bearer token by Vercel, server-only.
CRON_SECRET="replace-with-vercel-cron-secret"

# Playwright runs exclusively against a separate staging deployment and Supabase project.
E2E_BASE_URL="https://your-staging-preview.example.com"
E2E_EXPECTED_APP_ORIGIN="https://your-staging-preview.example.com"
E2E_ADMIN_EMAIL="replace-with-staging-admin-email"
E2E_ADMIN_PASSWORD="replace-with-staging-admin-password"
E2E_ATTESTATION_TOKEN="replace-with-random-staging-secret-at-least-32-characters"
# Runner-only copy of the 32-character Vercel Deployment Protection automation
# bypass. Never prefix with NEXT_PUBLIC_, place in a URL, or expose to the app.
E2E_VERCEL_AUTOMATION_BYPASS_SECRET="replace-with-vercel-automation-bypass-secret"

# Fail-closed mutation gate. Keep false until every staging guard below is configured.
E2E_ALLOW_MUTATIONS="false"
E2E_RUN_MUTABLE="false"
VERCEL_ENV="preview"
E2E_EXPECTED_PROJECT_REF="your-staging-project-ref"

# Production project/application identifiers are versioned denylist constants in
# scripts/e2e/staging-guard.mjs; they are intentionally not supplied by env. The
# audited staging ref must also be committed to its positive allowlist.

# This table and row must exist only in staging. The guard performs a read-only lookup.
E2E_STAGING_MARKER_TABLE="e2e_environment_guard"
E2E_STAGING_MARKER_ID="replace-with-staging-only-marker-id"
E2E_STAGING_MARKER_ID_COLUMN="id"
